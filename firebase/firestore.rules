rules_version = '2';

// Regras do Firestore da plataforma GIG (glean.com.br/gig) — firebase/firestore.rules.
// Cole o arquivo inteiro em Firebase Console → Firestore Database → Rules.
//
// Só entra quem tem conta Google verificada do domínio glean.ufsc.br. Os papéis
// vêm do documento membros/{uid}.papel: "lider", "gp" (Gestão de Pessoas) ou
// "membro". A liderança promove o primeiro líder editando esse campo no Console.
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('.*@glean[.]ufsc[.]br');
    }
    function meuCadastro() {
      return get(/databases/$(database)/documents/membros/$(request.auth.uid)).data;
    }
    function lider() { return logado() && meuCadastro().papel == 'lider'; }
    function gestao() { return logado() && meuCadastro().papel in ['lider', 'gp']; }
    function eu(uid) { return logado() && request.auth.uid == uid; }

    // ---- membros: o próprio usuário cria seu cadastro no primeiro login,
    // sempre como "membro" e sem cargos; só a liderança muda papel/módulo/cargos.
    match /membros/{uid} {
      allow read: if logado();
      allow create: if eu(uid)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.papel == 'membro'
        && request.resource.data.cargos.size() == 0;
      allow update: if lider()
        || (eu(uid) && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['nome', 'foto', 'padroes', 'atualizadoEm']));
      allow delete: if lider();
    }

    // ---- catálogos e configuração
    match /semestres/{id} { allow read: if logado(); allow write: if lider(); }
    match /processos/{id} { allow read: if logado(); allow write: if lider(); }
    match /atividades/{id} { allow read: if logado(); allow write: if lider(); }
    match /config/{id} { allow read: if logado(); allow write: if gestao(); }

    // ---- GIG semanal: cada um escreve só o seu; todos leem (gestão visual).
    match /gig/{id} {
      allow read: if logado();
      allow create, update: if eu(request.resource.data.uid);
      allow delete: if lider() || eu(resource.data.uid);
    }

    // ---- pesquisinha: respostas individuais são sensíveis. O id é
    // "{semestre}_{semana}_{uid}", então o dono é lido do próprio id (isso
    // também permite checar se a resposta da semana já existe).
    match /clima/{id} {
      allow read: if gestao() || eu(id.split('_')[2]);
      allow create, update: if eu(request.resource.data.uid);
      allow delete: if lider();
    }

    // ---- quedas no ID: todos veem o quadro; só liderança/GP registram.
    match /quedas/{id} {
      allow read: if logado();
      allow create, update, delete: if gestao();
    }

    // ---- atas: qualquer membro cria; edita o autor ou a liderança.
    match /atas/{id} {
      allow read: if logado();
      allow create: if logado() && request.resource.data.autor == request.auth.uid;
      allow update, delete: if lider() || eu(resource.data.autor);
      // Qualquer membro pode vincular/desvincular uma ata a uma reunião da
      // agenda (só o campo "evento"; o conteúdo continua com o autor).
      allow update: if logado()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['evento']);
    }

    // ---- encaminhamentos: qualquer membro cria; muda status o responsável,
    // quem criou ou a liderança.
    match /encaminhamentos/{id} {
      allow read: if logado();
      allow create: if logado() && request.resource.data.criadoPor == request.auth.uid;
      allow update: if lider() || eu(resource.data.responsavel) || eu(resource.data.criadoPor);
      allow delete: if lider() || eu(resource.data.criadoPor);
    }

    // Um membro só pode mexer na própria chave de um mapa (ex.: marcar a
    // própria DDL como feita, registrar que respondeu um formulário).
    function soMinhaChave(campo) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([campo])
        && request.resource.data.get(campo, {}).diff(resource.data.get(campo, {}))
             .affectedKeys().hasOnly([request.auth.uid]);
    }

    // ---- DDLs (tarefas com prazo): qualquer membro cria para um grupo;
    // edita/exclui quem criou ou a liderança; cada destinatário marca a sua.
    match /ddls/{id} {
      allow read: if logado();
      allow create: if logado() && request.resource.data.criadoPor == request.auth.uid;
      allow update, delete: if lider() || eu(resource.data.criadoPor);
      allow update: if logado() && soMinhaChave('concluidos');
    }

    // ---- formulários: qualquer membro cria; edita o autor ou a liderança.
    // As respostas ficam numa subcoleção: cada um lê/escreve só a sua, e o
    // autor do formulário e a liderança leem todas.
    match /formularios/{fid} {
      allow read: if logado();
      allow create: if logado() && request.resource.data.autor == request.auth.uid;
      allow update, delete: if lider() || eu(resource.data.autor);
      allow update: if logado() && soMinhaChave('respondentes');

      match /respostas/{uid} {
        function form() { return get(/databases/$(database)/documents/formularios/$(fid)).data; }
        allow read: if eu(uid) || lider() || eu(form().autor);
        allow create, update: if eu(uid) && request.resource.data.uid == uid && form().get('aberto', true) != false;
        allow delete: if lider() || eu(form().autor);
      }
    }

    // ---- chat: conversas diretas (id dm_<uidA>_<uidB>) e grupos. Só quem
    // participa lê e escreve; a lista do app filtra por "membros contém eu".
    function conversa(cid) { return get(/databases/$(database)/documents/conversas/$(cid)).data; }
    function participo(cid) { return logado() && request.auth.uid in conversa(cid).membros; }
    // conversa direta: o id é sempre dm_<uidA>_<uidB> com os próprios membros
    // (ou dm_<eu>_<eu>, a conversa comigo mesmo, para anotações)
    function idDiretaValido(cid, m) {
      return (m.size() == 2 && (cid == 'dm_' + m[0] + '_' + m[1] || cid == 'dm_' + m[1] + '_' + m[0]))
        || (m.size() == 1 && cid == 'dm_' + m[0] + '_' + m[0]);
    }

    match /conversas/{cid} {
      // resource == null: checar se a conversa direta já existe antes de criá-la
      allow read: if logado() && (resource == null || request.auth.uid in resource.data.membros);
      allow create: if logado()
        && request.resource.data.criadoPor == request.auth.uid
        && request.auth.uid in request.resource.data.membros
        && ((request.resource.data.tipo == 'grupo' && request.resource.data.admins.hasOnly([request.auth.uid]))
            || (request.resource.data.tipo == 'direta' && idDiretaValido(cid, request.resource.data.membros)));
      allow update: if logado() && request.auth.uid in resource.data.membros && (
        // qualquer participante: última mensagem e "lida até"
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ultima', 'atualizadoEm', 'lidas'])
        // administradores do grupo (e a liderança): nome, foto, membros, admins…
        || (resource.data.tipo == 'grupo' && (request.auth.uid in resource.data.admins || lider())
            && request.resource.data.tipo == 'grupo' && request.resource.data.criadoPor == resource.data.criadoPor)
        // sair do grupo: só tirar a si mesmo
        || (resource.data.tipo == 'grupo'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['membros', 'admins', 'atualizadoEm'])
            && request.resource.data.membros.toSet() == resource.data.membros.toSet().difference([request.auth.uid].toSet()))
      );
      allow delete: if lider();

      match /mensagens/{mid} {
        allow read: if participo(cid);
        allow create: if participo(cid) && request.resource.data.autor == request.auth.uid;
        // só o autor mexe na própria mensagem (apagar para todos)
        allow update: if participo(cid) && resource.data.autor == request.auth.uid
          && request.resource.data.autor == resource.data.autor;
        allow delete: if false;
      }

      // anexos: o arquivo em pedaços de até ~800 KB (base64)
      match /anexos/{aid}/partes/{n} {
        allow read: if participo(cid);
        allow create: if participo(cid) && request.resource.data.autor == request.auth.uid
          && request.resource.data.dados.size() <= 900000;
        allow update, delete: if false;
      }
    }

    // ---- figurinhas criadas pelos membros (imagens pequenas, até ~200 KB)
    match /figurinhas/{id} {
      allow read: if logado();
      allow create: if logado() && request.resource.data.criadoPor == request.auth.uid
        && request.resource.data.dados is string && request.resource.data.dados.size() <= 200000;
      allow delete: if lider() || eu(resource.data.criadoPor);
    }
  }
}
